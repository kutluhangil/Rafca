# Rafça Çevre Değişkenleri ve Derleme Parametreleri (Build Configuration)

# Sentry DSN (Hata ve Çökme Takibi)
# Proje: Rafca (Sentry.io üzerinde Flutter projesi)
# Canlı DSN tanımlandığında Sentry otomatik olarak devreye girer.
# Boş bırakıldığında uygulama yerel OfflineErrorQueue ile %100 çevrimdışı çalışır.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Supabase Entegrasyonu (İsteğe bağlı bulut yedekleme - Faz 3)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
